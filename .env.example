# Application Configuration
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
API_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
DATABASE_URL_SHADOW=postgresql://user:password@localhost:5432/auth_db_shadow

# JWT & Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-1234567890
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-min-32-chars-long
REFRESH_TOKEN_EXPIRE=7d
JWT_ALGORITHM=HS256

# OTP & 2FA
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_HMAC_SECRET=your-otp-hmac-secret-min-16-chars-long
TOTP_WINDOW=1

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
ACCOUNT_LOCK_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=30
CONCURRENT_SESSION_LIMIT=5

# Redis (for message queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# Legacy Email Configuration (SMTP)
# For development only - production uses SendGrid
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@yourapp.com
SMTP_FROM_NAME=Your App Name

# SendGrid Configuration (Production)
# https://sendgrid.com - Recommended for production
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_WEBHOOK_KEY=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid Dynamic Templates
# Create templates in SendGrid and set their IDs here
SENDGRID_TEMPLATE_VERIFICATION=d-verification-template-id
SENDGRID_TEMPLATE_EMAIL_VERIFIED=d-verified-template-id
SENDGRID_TEMPLATE_LOGIN_OTP=d-otp-template-id
SENDGRID_TEMPLATE_PASSWORD_RESET=d-reset-template-id
SENDGRID_TEMPLATE_PASSWORD_CHANGED=d-changed-template-id
SENDGRID_TEMPLATE_2FA_ENABLED=d-2fa-template-id
SENDGRID_TEMPLATE_LOGIN_NOTIFICATION=d-login-notif-template-id
SENDGRID_TEMPLATE_ACCOUNT_LOCKED=d-locked-template-id
SENDGRID_TEMPLATE_ACCOUNT_UNLOCKED=d-unlocked-template-id
SENDGRID_TEMPLATE_SUSPICIOUS_ACTIVITY=d-suspicious-template-id

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX_REQUESTS=5

# Feature Flags
FEATURE_2FA=true
FEATURE_DEVICE_MANAGEMENT=true
FEATURE_SESSION_MANAGEMENT=true
FEATURE_AUDIT_LOGGING=true

# Security
ENABLE_HTTPS=false
SECURE_COOKIES=false
SAME_SITE_COOKIES=Lax
ENABLE_CSRF=true
HELMET_ENABLED=true
TRUST_PROXY=false

# Monitoring
ENABLE_METRICS=false
METRICS_PORT=9090

# Queue
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
